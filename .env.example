# Общие настройки
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# M0–M2: SQLite. Для профиля postgres замените значение на строку ниже.
DATABASE_URL=sqlite+aiosqlite:///./data/teambot.db
# DATABASE_URL=postgresql+asyncpg://teambot:teambot@postgres:5432/teambot

# Настройки SQLite (DB-9)
SQLITE_BUSY_TIMEOUT_MS=5000
SQLITE_BACKUP_DIR=./data/backups
SQLITE_BACKUP_CRON=0 3 * * *

# PostgreSQL из docker compose (профиль postgres)
POSTGRES_DB=teambot
POSTGRES_USER=teambot
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Политика хранения, значение предстоит подтвердить владельцу проекта.
RETENTION_AUDIO_DAYS=30

# Имя первой рабочей группы. Создаётся идемпотентно вместе с владельцем M1.
INITIAL_TEAM_NAME=Команда
# Срок жизни одноразовых кодов /invite, /link и /bind в минутах.
ACCESS_CODE_TTL_MINUTES=15

# Telegram (этап M1). Токен выдаёт BotFather при создании бота.
# На старте используется long polling, поэтому публичный адрес не требуется.
TELEGRAM_BOT_TOKEN=
# Числовой идентификатор пользователя Telegram, который станет owner первой команды.
# Повторный запуск с тем же значением не создаёт вторую команду.
TELEGRAM_BOOTSTRAP_OWNER_ID=
# Секрет проверяет подлинность webhook-запросов. Для long polling не нужен;
# заполните его только при будущем переходе на webhook.
TELEGRAM_WEBHOOK_SECRET=

# VK (этап M6). Токен сообщества с разрешением на работу с сообщениями.
# Личный пользовательский токен здесь использовать нельзя.
VK_GROUP_TOKEN=

# LLM и локальные модели (этап M2). Пустые ключи не активируют провайдеры.
# ProxyAPI предоставляет единый доступ к моделям через российский API.
# Базовый адрес взят из https://proxyapi.ru/docs; ключ создаётся в кабинете.
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
PROXYAPI_KEY=
# Ключ прямого подключения к Z.ai. Маршрут и модель задаются на этапе M2.
ZAI_API_KEY=
# Ключ GigaChat. Способ подключения (напрямую или через ProxyAPI) ещё выбирается.
GIGACHAT_API_KEY=
# Адрес локально развёрнутого LLM-сервера; конкретный API уточняется на M2.
LOCAL_LLM_URL=
# Токен Hugging Face для gated-моделей pyannote на этапе M3.
# Нужен только после принятия условий использования выбранных моделей.
HF_TOKEN=
